				resumeUrl={RESUME_URL}
				linkedinUrl={LINKEDIN_URL}
				email={EMAIL}
				currentCompany="Inetum"
				currentPosition="Data Engineer"
				showPlot={false}
			/>

			<section class="section section-animate" id="lineage">
				<div class="wrap">
					<div class="masthead">

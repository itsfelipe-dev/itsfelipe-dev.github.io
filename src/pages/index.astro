	{ src: wsHomePortrait, caption: "back home · portrait" },
	{ src: wsCelebration, caption: "the celebration" },
	{ src: wsMedal, caption: "the medal" },
];

async function buildGallery() {
	const widths = [400, 640, 880];
	return Promise.all(
		wsImages.map(async (g) => {
			const variants = await Promise.all(
				widths.map((w) =>
					getImage({
						src: g.src,
						width: w,
						format: "webp",
						fit: "cover",
					}),
				),
			);
			const srcset = variants
				.map((v) => `${v.src} ${v.attributes.width}w`)
				.join(", ");
			const biggest = variants[variants.length - 1];
			return { caption: g.caption, src: biggest.src, srcset };
		}),
	);
}

